# Development image of the API (Express). Built by docker-compose.yml with the repository root as context:
#   docker compose up --build        (or: npm run docker:up)
# Linux container (Debian bookworm), so it runs the same on Windows (Docker Desktop, WSL 2), macOS and Ubuntu.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=development

# Dependencies first, so a code change does not reinstall them. npm workspaces need every package.json.
# Installed inside Linux: native packages (sharp) get their Linux builds, never the ones of a Windows checkout.
# --ignore-scripts skips the root postinstall (it writes .env files; the container gets its settings from compose).
COPY package.json package-lock.json ./
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci --workspace backend --include-workspace-root=false --ignore-scripts --no-audit --no-fund \
  && npm cache clean --force

# The code. docker-compose.yml also mounts backend/src over it, so edits restart the API without a rebuild.
COPY backend/index.js backend/
COPY backend/src backend/src
# The seed reads the photo list of the 8 pilot checkpoints from the frontend.
COPY frontend/src/api/places.json frontend/src/api/places.json

WORKDIR /app/backend
RUN mkdir -p uploads && chown -R node:node /app/backend/uploads
USER node
EXPOSE 3000

# Migrate and seed (both safe to repeat), add the fictional demo players once, then run with restart on change.
# Settings come from the environment (env_file in docker-compose.yml), not from a .env file inside the image.
CMD ["sh", "-c", "node src/db/migrate.js && node src/db/seed.js && node src/db/seed-demo.js && exec node --watch index.js"]
