# Copy to backend/.env (done automatically by `npm install`). NEVER commit backend/.env.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Only set this when the API runs behind a reverse proxy (number of proxy hops, e.g. 1). Leave empty otherwise:
# trusting X-Forwarded-For without a proxy lets clients fake their IP and dodge the rate limits.
TRUST_PROXY=

# MySQL (docker compose publishes it on port 3307)
DATABASE_URL=mysql://cq:cq_dev_password@127.0.0.1:3307/campusquest
TEST_DATABASE_URL=mysql://cq:cq_dev_password@127.0.0.1:3307/campusquest_test

# Secrets (generated automatically by `npm install`)
SESSION_SECRET=change-me-session-secret
OTP_SECRET=change-me-otp-secret

# Login (BR01-BR03). Only addresses ending with this domain may sign in.
ALLOWED_EMAIL_DOMAIN=heilbronn.dhbw.de
OTP_TTL_MINUTES=10
OTP_MAX_FAILED_ATTEMPTS=5
# Resend limits: 30 s between codes and 5 per hour per address. Override only to test the limits.
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_RESEND_MAX_PER_HOUR=5
SESSION_INACTIVITY_MINUTES=30

# E-mail delivery of OTP codes. Set SMTP_HOST to send real e-mails (required when NODE_ENV=production).
# Without SMTP_HOST, codes reach people only through the code preview below. The server logs "[mail] SMTP ready"
# at start-up when the login works. Examples (use an app password, never your normal password):
#   Gmail:            SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_USER=you@gmail.com
#   Microsoft 365:    SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USER=you@yourdomain
#   Brevo / Mailjet:  the SMTP host, port and key from the provider dashboard
# SMTP_FROM must be an address the account may send as.
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the first byte (port 465). Empty = automatic (465 TLS, otherwise STARTTLS is required).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DHBW campusGO <no-reply@localhost>

# BR52 code preview: also show every login code in the test inbox of the login page and print it in this terminal.
# Admins switch it on and off at run time (admin page "Settings"); this is only the start value before they do.
# Default: on in development, off everywhere else. NEVER leave it on for real students: anyone could log in as anyone.
# OTP_PREVIEW_DEFAULT=false

# Teams (BR05, BR06)
INVITATION_TTL_HOURS=24

# Geofencing (BR12, BR13; Main Project Document section 5). Per-checkpoint centre and radius live in the database.
# Lenient on purpose: phones are rarely exact indoors. MAX_ACCURACY_M is the worst GPS accuracy accepted,
# GEOFENCE_SLACK_M is added to every radius, ACCURACY_CREDIT_M is how much of a reading's own error margin counts
# in the student's favour, NEARER_MARGIN_M is how much nearer another checkpoint must be.
# Raise MAX_ACCURACY_M (e.g. 500) only for desktop tests with a faked location.
MAX_ACCURACY_M=200
GEOFENCE_SLACK_M=30
ACCURACY_CREDIT_M=50
NEARER_MARGIN_M=20
MAX_POSITION_AGE_MS=30000
SECONDS_PER_QUESTION=60
VERIFY_LIMIT_PER_MIN=10

# Pre-seeded admin accounts, comma-separated (BR37). The first is the main admin; these addresses may log in
# even outside ALLOWED_EMAIL_DOMAIN. Both are protected: they cannot be deleted, blocked or demoted.
ADMIN_EMAIL=sekretariat.dski@heilbronn.dhbw.de,dhbw.campus@gmail.com
LOCATION_RETENTION_DAYS=7

# Profile pictures (BR02, BR05)
MAX_PROFILE_PICTURE_MB=2

# NOTE: points, bonuses, multipliers, question counts and pass thresholds are NOT configured here.
# They live in database tables (BR11) so they can change without changing backend code.
