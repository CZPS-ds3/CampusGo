# Copy to .env and fill in. NEVER commit .env.
PORT=3000
DATABASE_URL=
SESSION_SECRET=

# Login (BR01-BR03). Only addresses ending with this domain may sign in.
ALLOWED_EMAIL_DOMAIN=heilbronn.dhbw.de
OTP_TTL_MINUTES=10
OTP_MAX_FAILED_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_MAX_PER_HOUR=5
SESSION_INACTIVITY_MINUTES=30

# E-mail delivery of OTP codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Teams (BR05, BR06)
INVITATION_TTL_HOURS=24

# Location verification (BR12). Per-checkpoint radius lives in the database.
MAX_ACCURACY_M=50
LOCATION_VERIFICATION_VALID_MINUTES=5
LOCATION_RETENTION_DAYS=7

# Profile pictures (BR02, BR05)
MAX_PROFILE_PICTURE_MB=2

# NOTE: points, bonuses, multipliers, question counts and pass thresholds are NOT configured here.
# They live in database tables (BR11) so they can change without changing backend code.
