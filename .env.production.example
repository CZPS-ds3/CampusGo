# Settings for the production stack (docker-compose.prod.yml). Copy to .env.production on the server and fill
# in every value. .env.production is ignored by git: never commit it, never paste its values anywhere.
#
# Make random secrets with:   openssl rand -hex 32

# --- Address -------------------------------------------------------------------------------------------------
# The public https address of the subdomain (no trailing slash). The school's web server terminates HTTPS and
# forwards to this server on HTTP_PORT. Must start with https:// (browsers only give location over HTTPS).
PUBLIC_URL=https://campusgo.example.heilbronn.dhbw.de
# The port on the Ubuntu server that the school's web server forwards to.
HTTP_PORT=8080
# Which network address the port listens on. 0.0.0.0 = every address (then let only the school's web server in
# with the firewall, see README); 127.0.0.1 = only this machine (when the school's web server runs here too).
HTTP_BIND=0.0.0.0
# The school's web server as seen from this machine (ask IT): IP addresses or CIDR ranges, comma separated.
# Only requests from these addresses may say which visitor IP they forward (X-Forwarded-For). Required: the
# per-IP rate limits on login codes depend on it. Web server on this machine: the Docker gateway, 172.16.0.0/12.
TRUSTED_PROXIES=

# --- Database (letters and digits only: the password is part of a URL) -----------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# --- Secrets (at least 32 random characters each; the API refuses to start otherwise) -----------------------
SESSION_SECRET=
OTP_SECRET=

# --- E-mail for the login codes (required in production) -----------------------------------------------------
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, SMTP_USER = the address, SMTP_PASSWORD = an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DHBW campusGO <your-address@example.com>

# --- Administrators (BR37) ------------------------------------------------------------------------------------
# Comma-separated; the first is the main admin. Empty = the default study office + shared mailbox.
ADMIN_EMAILS=sekretariat.dski@heilbronn.dhbw.de,dhbw.campusgo@gmail.com

# --- Optional map settings (empty = the app's defaults; they are built into the web app) -------------------
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_BASE=
VITE_MAP_VIEW=
VITE_ROUTING_URL=
