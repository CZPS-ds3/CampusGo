# Copy to frontend/.env (done automatically by `npm install`).
# Empty = use the Vite dev proxy (/api -> http://localhost:3000).
VITE_API_URL=
# true = run without a backend, using mock data (npm run dev:mock sets this for you)
VITE_USE_MOCKS=false
# Map tiles. The default OpenStreetMap tiles are fine for development; for a real launch use a tile provider
# whose terms allow it. The page darkens light tiles itself (VITE_MAP_DARKEN=false for tiles that are already dark).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_MAP_DARKEN=true
# The map starts with the open LGL Baden-Wuerttemberg aerial photo (2026, shows the Sensoricum); users can switch
# to the street map above. street = start with the street map instead. Aerial photo: WMS address and layer name.
VITE_MAP_BASE=aerial
VITE_MAP_AERIAL_URL=https://owsproxy.lgl-bw.de/owsproxy/ows/WMS_LGL-BW_ATKIS_DOP_20_C
VITE_MAP_AERIAL_LAYER=IMAGES_DOP_20_RGB
# 2d = the flat Leaflet map first (default); 3d = the tilted MapLibre map with buildings first. Users can switch
# both in the preferences and on the map. The 3D map uses OpenFreeMap vector styles (no key); light and dark style:
VITE_MAP_VIEW=2d
VITE_MAP_3D_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_3D_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# Development only: show a "pretend I am here" switch in the location check
VITE_DEV_FAKE_LOCATION=false
# Walking route helper (OpenStreetMap foot router). The public server has a fair-use policy.
VITE_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
